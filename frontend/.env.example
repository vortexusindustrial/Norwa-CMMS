# Google Maps JavaScript API key (enable "Maps JavaScript API" in Google Cloud Console).
# https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# Map ID required by AdvancedMarkerElement. DEMO_MAP_ID works for local dev;
# create a real Map ID in Google Cloud Console (Maps Management) for production.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
